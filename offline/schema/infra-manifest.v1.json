{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lattice-substrate.github.io/json-canon/offline/schema/infra-manifest.v1.json",
  "title": "json-canon infrastructure manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "infra_repo_url",
    "infra_repo_commit",
    "provider_engine",
    "provider_version",
    "provider_lock_sha256",
    "hosts",
    "tools"
  ],
  "properties": {
    "schema_version": { "const": "infra-manifest.v1" },
    "generated_at_utc": { "type": "string", "minLength": 1 },
    "infra_repo_url": { "type": "string", "minLength": 1 },
    "infra_repo_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "provider_engine": { "type": "string", "minLength": 1 },
    "provider_version": { "type": "string", "minLength": 1 },
    "provider_lock_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "architecture",
          "node_ids",
          "role",
          "cloud_provider",
          "region",
          "instance_type",
          "image_id"
        ],
        "properties": {
          "architecture": { "type": "string", "enum": ["x86_64", "arm64"] },
          "node_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "role": { "type": "string", "minLength": 1 },
          "cloud_provider": { "type": "string", "minLength": 1 },
          "region": {
            "type": "string",
            "minLength": 1,
            "description": "AWS region. When iid_verified=true this value is expected to match the verified instance-identity document."
          },
          "availability_zone": {
            "type": "string",
            "minLength": 1,
            "description": "Availability zone discovered from IMDS. This field is host-reported and not covered by the verified AWS instance-identity document."
          },
          "instance_type": { "type": "string", "minLength": 1 },
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "description": "EC2 instance ID. When iid_verified=true this value is bound to the verified AWS instance-identity document."
          },
          "image_id": {
            "type": "string",
            "minLength": 1,
            "description": "AMI ID. When iid_verified=true this value is bound to the verified AWS instance-identity document."
          },
          "os_id": {
            "type": "string",
            "minLength": 1,
            "description": "Host-discovered operating-system identifier from /etc/os-release. Self-reported by the worker."
          },
          "os_version_id": {
            "type": "string",
            "minLength": 1,
            "description": "Host-discovered operating-system version from /etc/os-release. Self-reported by the worker."
          },
          "cpu": {
            "type": "string",
            "minLength": 1,
            "description": "Host-discovered CPU model string from /proc/cpuinfo. Self-reported by the worker."
          },
          "kernel": {
            "type": "string",
            "minLength": 1,
            "description": "Host-discovered kernel string from /proc/version. Self-reported by the worker."
          },
          "iid_document_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$",
            "description": "SHA-256 of the raw AWS instance-identity document retrieved from IMDS."
          },
          "iid_signature_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$",
            "description": "SHA-256 of the raw base64 IID RSA signature retrieved from IMDS."
          },
          "iid_pkcs7_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$",
            "description": "SHA-256 of the raw IID PKCS7 blob retrieved from IMDS."
          },
          "iid_verified": {
            "type": "boolean",
            "description": "True when the orchestrator verified the AWS instance-identity signature and matched the IID-backed identity fields against the provisioned host."
          },
          "transport": { "type": "string", "enum": ["ssh", "ssm"] },
          "subnet_visibility": { "type": "string", "enum": ["public", "private"] },
          "discovered_cpu": { "type": "string", "minLength": 1 },
          "discovered_kernel": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "purpose",
          "name",
          "version",
          "os",
          "arch",
          "format",
          "source_url",
          "sha256",
          "artifact_relative_path"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "enum": ["host", "remote"] },
          "purpose": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "os": { "type": "string", "minLength": 1 },
          "arch": { "type": "string", "enum": ["amd64", "arm64"] },
          "format": { "type": "string", "enum": ["raw", "tar.gz", "zip"] },
          "source_url": { "type": "string", "pattern": "^https://.+" },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "artifact_relative_path": { "type": "string", "minLength": 1 },
          "executable_relative_path": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
